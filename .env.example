# ---- Acesso ao servidor (obrigatório) ----
# Senha da interface web. Mínimo 12 caracteres. O servidor não sobe sem ela.
APP_PASSWORD=
# Token para a API (header "Authorization: Bearer <token>"). Mínimo 24 caracteres.
API_TOKEN=

# ---- Credencial do Claude (uma das duas) ----
# Assinatura Pro/Max: rode `claude setup-token` na sua máquina e cole o token gerado.
CLAUDE_CODE_OAUTH_TOKEN=
# Ou: chave da API da Anthropic (cobrança por uso).
# ANTHROPIC_API_KEY=

# ---- Opcionais ----
# CLAUDE_MODEL=claude-opus-5-5     # modelo padrão
# CLAUDE_EFFORT=high               # low | medium | high | xhigh | max
# BRAIN_REFLECT=auto               # auto (só tarefas com ferramentas) | always | off
# BRAIN_MODEL=                     # modelo da consolidação de memória (padrão: o mesmo da tarefa)
# MAX_CONCURRENT_RUNS=3            # tarefas simultâneas
# RUN_TIMEOUT_MIN=60               # tempo máximo por tarefa
# MAX_TURNS=                       # limite de passos por tarefa (padrão: sem limite)
# GH_TOKEN=                        # deixa o agente usar gh e git push no GitHub
# TERMINAL=on                      # off desliga o terminal web
# TERMINAL_IDLE_MIN=60             # encerra o shell após N minutos sem ninguém conectado
# GIT_USER_NAME=Habblaud Agent
# GIT_USER_EMAIL=agent@habblaud.com
# SESSION_SECRET=                  # padrão: derivado da APP_PASSWORD
# DATA_DIR=/data                   # onde fica o volume persistente

# ---- Agentes especializados (POST /api/v1/agentes/executar) ----
# CLIENT_TOKENS=hofos:<token>      # tokens de sistemas que só chamam os agentes (24+ caracteres)
# AGENTES=                         # JSON de ajustes, ex.: {"estrategista":{"modelo":"sonnet"}}
# AGENTES_MAX_SIMULTANEOS=8        # total de Claude Codes rodando ao mesmo tempo
# AGENTES_FILA_MAXIMA=60           # pedidos esperando, somando todos os agentes
# AGENTES_LIMITE_AUTOMATICO=0.7    # pedidos automáticos param com a assinatura nesse uso da janela
# AGENTES_LIMITE_TELA=0.95         # e os de tela, nesse
# AGENTES_RETENCAO_DIAS=3          # quanto tempo as transcrições dos agentes ficam

# ---- Escritório (Habblaud) ----
# ESCRITORIO=on                    # off desliga
# ESCRITORIO_HOSTS=                # domínio público do escritório (o que aponta para a porta 4748)
# ESCRITORIO_USUARIO=habblaud      # usuário do login do escritório (a senha é a APP_PASSWORD)
# ESCRITORIO_PORTA=4748
